graph TB
    %% ==================== CAMADA 1 — USUÁRIO ====================
    U(("Usuário<br/>navegador"))

    %% ==================== CAMADA 2 — ACESSO (host, só 127.0.0.1) ====================
    subgraph Host["Host — 127.0.0.1 (apenas loopback)"]
        direction TB
        subgraph Proxy["Container: proxy (nginx)"]
            P["Nginx reverse proxy\n127.0.0.1:8080 -> 80\ncabecalhos de seguranca\nsem CORS · mesma origem"]
        end
        subgraph Front["Container: front (FastAPI + Jinja2)"]
            F["Templates server-side\nindex.html · invoice.html\nHTMX + Tailwind (sem build)\nproxy v1 para back:8000\nporta 8001 (host)"]
        end
    end

    %% ==================== CAMADA 3 — APLICACAO (rede Docker cogme) ====================
    subgraph Rede["Rede Docker — cogme"]
        direction TB
        subgraph Back["Container: back (FastAPI/Uvicorn)"]
            B1["API /v1\nGET /v1/health\nGET /v1/rates/{currency}\nPOST /v1/simulate\nPOST /v1/invoice"]
            B2["Contrato de erro canonico\n{error:{key,message,details}}\nfail-closed · sem traceback"]
            B3["RateService\nFrankfurter para PTAX\ncircuit breaker · cache TTL"]
            B4["Camada de calculo e PDF\nDecimal (sem float) · WeasyPrint"]
            B5["Repositorio SQLAlchemy/asyncpg\ntabelas fx_quotes · invoices"]
        end
        subgraph Data["Container: db (PostgreSQL 15)"]
            D["Banco de dados\nrede data — interna\nsem rota para internet\nporta 5432 so em 127.0.0.1"]
        end
        subgraph Migra["Container: migrate (Alembic)"]
            M["alembic upgrade head\naplica o esquema\nroda e termina\nantes do back"]
        end
    end

    %% ==================== CAMADA 4 — EXTERNO (rede edge) ====================
    subgraph Externo["Fontes publicas de cotacao — rede edge (só back)"]
        Fr["Frankfurter — primaria\nHTTP GET"]
        Pt["PTAX — fallback\nHTTP GET"]
    end

    %% ==================== ECossistema SDD (fora do runtime da app) ====================
    subgraph SDD["Ecossistema SDD — fora do runtime da aplicacao"]
        L["llama.cpp · Qwen3-30B-A3B Q4_K_M\nCPU-only · local · sem CUDA/nuvem\ninferencia para agentes, nao para o fluxo da app"]
    end

    %% ==================== RELACIONAMENTOS ====================
    U -->|HTTP 127.0.0.1:8080| P
    P -->|UI| F
