{
  "mcpServers": {
    "git-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git"
      ],
      "env": {
        "GIT_PATH": "/usr/bin/git"
      }
    },
    "github-remote": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "docx-editor": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/home/leonardo/.local/share/mcp-servers/docx-mcp",
        "python",
        "server.py"
      ],
      "env": {}
    }
  }
}