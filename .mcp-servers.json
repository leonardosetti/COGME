{
  "mcpServers": {
    "github-remote": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "--allow-read",
        ".ai/specs",
        "--allow-read",
        "docs",
        "--allow-read",
        "scripts",
        "--allow-read",
        ".ai/handoffs"
      ],
      "env": {}
    },
    "nexus-ledger": {
      "command": "python3",
      "args": [
        "scripts/mcp_nexus_ledger.py"
      ],
      "env": {}
    },
    "nexus-dispatch": {
      "command": "python3",
      "args": [
        "scripts/mcp_nexus_dispatch.py"
      ],
      "env": {}
    },
    "nexus-kb": {
      "command": "python3",
      "args": [
        "scripts/mcp_nexus_kb.py"
      ],
      "env": {}
    },
    "nexus-validate": {
      "command": "python3",
      "args": [
        "scripts/mcp_nexus_validate.py"
      ],
      "env": {}
    },
    "docx-editor": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/home/leonardo/.local/share/mcp-servers/docx-mcp",
        "python",
        "server.py"
      ],
      "env": {}
    }
  }
}