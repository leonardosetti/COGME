# =============================================================================
# EXEMPLO DE CONFIGURAÇÃO DO COGME. TODOS OS VALORES ABAIXO SÃO DUMMY.
# Copie para `.env` (ignorado pelo Git) e troque as credenciais por valores
# próprios antes de subir a stack. Nunca versione o `.env` real.
# =============================================================================

# --- PostgreSQL (serviço `db`) ---
POSTGRES_USER=cogme
POSTGRES_PASSWORD=dummy-troque-esta-senha
POSTGRES_DB=cogme

# --- Backend (serviços `web` e `migrate`) ---
# O host `db` é o nome do serviço no compose. Se a senha tiver caracteres
# especiais, codifique-a na URL (percent-encoding). Deve casar com os valores
# POSTGRES_* acima.
COGME_DATABASE_URL=postgresql+asyncpg://cogme:dummy-troque-esta-senha@db:5432/cogme

# Opcionais (os valores abaixo são os padrões da aplicação)
COGME_RATE_TTL_SECONDS=3600
COGME_PROVIDER_TIMEOUT_SECONDS=0.9
COGME_LOG_LEVEL=INFO

# --- Testes de integração fora do Docker (opcional) ---
# Aponte para um PostgreSQL descartável; nunca para dados reais.
# COGME_TEST_DATABASE_URL=postgresql+asyncpg://cogme:dummy-dev-local@127.0.0.1:5433/cogme_test
# Porta 5433 porque 5432 costuma estar ocupada no host.
